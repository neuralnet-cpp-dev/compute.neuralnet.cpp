// ── matmul_q_i8.comp — 三值权重 × int8 激活的量化 GEMM（P3，W1.58A8）──────
// C = (τ∘A)·(s∘Q)：A 以 2 bit/权重打包（见 trit_pack.comp），Q 以 8 bit/元素
// 打包（见 quantize_i8.comp / int8_pack.hpp）：
//   C[m,n] = τ_m · s_n · Σ_k trit(m,k)·q(k,n)
// 权重读 0.25 B、激活读 1 B/元素（f16 的 1/2）；int32 累加 + 双向量缩放。
//
// **分块形态（2026-11-15 重写，与 matmul_q.comp 同构）**：16×16 线程 /
// BM=BN=64 / BK=16 / 每线程 4×4 / 双缓冲。W 的 trit tile 与 Q 的 int8 tile
// 各解码**一次进共享内存**（每 tile 的每个打包字只被全局读一次），之后与
// f16 分块 GEMM 同构地累加；此前是"每输出元素独立解码"的参考内核（宽 batch
// 下同一字被重复读 N/M 次，~500 GFLOPS 封顶）。P1 旧式 bank swizzle（与
// matmul_q / matmul_tiled 现行同式，写读同式 involution）。
//
// **数值口径（逐位不变，int8_act_test 锁）**：int32 累加、k 升序（tile 升序
// × tile 内 k 升序 = 全局升序）；oob 元素贡献 0（x+0≡ x）；epilogue 恒
// `τ_m · s_n · float(acc)`（(τ·s)·acc 左结合，与宿主参考/CPU 同序）。
// 不做 τ/s 外提、不做 int8→f32 提前转换。
//
// 精度变体（glslc -DNN_SHADER_F16=1）：Y 声明 float16_t（f32 累加 + 写出 RNE，
// 与 matmul_q_f16 同款）；打包字缓冲恒 uint、τ/s 恒 float。
// ─────────────────────────────────────────────────────────────────────────
#version 450

#if defined(NN_SHADER_F16)
#extension GL_EXT_shader_16bit_storage : require
#define NN_ETYPE float16_t
#include "nn_f16_rne.glsl"
#define NN_WR(x) float16_t(nn_f16_rne(x))
#else
#define NN_ETYPE float
#define NN_WR(x) x
#endif

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly  buffer BufW { uint W[]; };   // 打包三值 (M*wpr_w)
layout(std430, binding = 1) readonly  buffer BufT { float T[]; };  // τ (M)
layout(std430, binding = 2) readonly  buffer BufQ { uint Q[]; };   // 打包 int8 (K*wpr_q)
layout(std430, binding = 3) readonly  buffer BufS { float S[]; };  // per-token 尺度 (N)
layout(std430, binding = 4) writeonly buffer BufY { NN_ETYPE Y[]; };  // (M*N)
#if !defined(NN_SHADER_F16)
layout(std430, binding = 4) writeonly buffer BufYv4 { vec4 Yv4[]; };
#endif

layout(push_constant) uniform Push {
    uint M;
    uint N;
    uint K;
    uint wpr_w;   // ceil(K/16)
    uint wpr_q;   // ceil(N/4)
};

const uint BM = 64u, BN = 64u, BK = 16u;
const uint EPT_A = (BM * BK) / 256u;   // 4
const uint EPT_B = (BK * BN) / 256u;   // 4

// Ash[stage][k][m>>2][m&3]：trit 分块（int，与 matmul_q 同布局）
// Bsh[stage][k][n>>2][n&3]：int8 分块（解码后的符号扩展值）
shared ivec4 Ash[2][BK][BM / 4];
shared ivec4 Bsh[2][BK][BN / 4];

// ── Bank swizzle（P1 旧式；写读同式，involution）─────────────────────────
#define SWZ_A(k, slot) ((slot) ^ (((k) >> 2) & (BM / 4u - 1u)))
#define SWZ_B(k, slot) ((slot) ^ (((k) >> 2) & (BN / 4u - 1u)))

// ── W（trit）分块装载：BM×BK，每线程 1 个 4 元素组 ───────────────────────
// A 恒为 (M,K) 打包（matmul_q_i8 无 transA）：组内 4 个连续 k、同一存储行 m。
// BK=16 ∧ BM%16==0 ⇒ 组内 (cj>>4) 恒同 ⇒ 每组只读 1 次打包字。
void load_W_tile(uint t, uint stage, uint tid, uint block_row)
{
    const uint g = tid;                       // EPT_A/4 = 1
    const uint m = (4u * g) / BK;             // tid/4 ∈ 0..63
    const uint c0 = t * BK + (4u * g) % BK;   // 组首 k，%16 ∈ {0,4,8,12}
    const uint sr = block_row + m;
    const bool inrow = (sr < M);
    const uint word = (inrow && c0 < K) ? W[sr * wpr_w + (c0 >> 4u)] : 0u;
    const uint k0 = c0 - t * BK;
    for (uint j = 0u; j < 4u; ++j)
    {
        const uint cj = c0 + j;
        int v = 0;
        if (inrow && cj < K)
            v = int((word >> (2u * (cj & 15u))) & 3u) - 2;   // 码值 = 三值 + 2
        Ash[stage][k0 + j][SWZ_A(k0 + j, m >> 2)][m & 3u] = v;
    }
}

// ── Q（int8）分块装载：BK×BN，每线程 1 个 4 元素组 ───────────────────────
// Q 恒 (K,N) 行主序：组内 4 个连续 n、同一存储行 k；n0%4==0 ⇒ 同一字节字。
void load_Q_tile(uint t, uint stage, uint tid, uint block_col)
{
    const uint g = tid;                       // EPT_B/4 = 1
    const uint k  = (4u * g) / BN;            // tid/16 ∈ 0..15
    const uint n0 = (4u * g) % BN;            // (tid%16)*4
    const uint gr = t * BK + k;
    const uint gc = block_col + n0;
    const bool inrow = (gr < K);
    const uint word = (inrow && gc < N) ? Q[gr * wpr_q + (gc >> 2u)] : 0u;
    for (uint j = 0u; j < 4u; ++j)
    {
        int v = 0;
        if (inrow && gc + j < N)
        {
            const uint qb = (word >> (8u * j)) & 0xFFu;   // n0%4==0 ⇒ 字节 j
            v = int(qb) - (qb >= 128u ? 256 : 0);         // int8 符号扩展
        }
        Bsh[stage][k][SWZ_B(k, n0 >> 2u)][j] = v;
    }
}

void main()
{
    const uint tx = gl_LocalInvocationID.x;
    const uint ty = gl_LocalInvocationID.y;
    const uint tid = ty * 16u + tx;

    const uint block_row = gl_WorkGroupID.y * BM;
    const uint block_col = gl_WorkGroupID.x * BN;

    ivec4 acc[4];
    for (uint i = 0u; i < 4u; ++i) acc[i] = ivec4(0);

    const uint num_tiles = (K + BK - 1u) / BK;
    load_W_tile(0u, 0u, tid, block_row);
    load_Q_tile(0u, 0u, tid, block_col);
    barrier();

    uint stage = 0u;
    for (uint t = 0u; t < num_tiles; ++t)
    {
        const uint nxt = t + 1u;
        const uint nstage = stage ^ 1u;
        if (nxt < num_tiles)
        {
            load_W_tile(nxt, nstage, tid, block_row);
            load_Q_tile(nxt, nstage, tid, block_col);
        }
        #pragma unroll 4
        for (uint k = 0u; k < BK; ++k)
        {
            const ivec4 a_vec = Ash[stage][k][SWZ_A(k, ty)];
            const ivec4 b_vec = Bsh[stage][k][SWZ_B(k, tx)];
            acc[0] += a_vec.x * b_vec;
            acc[1] += a_vec.y * b_vec;
            acc[2] += a_vec.z * b_vec;
            acc[3] += a_vec.w * b_vec;
        }
        barrier();
        stage = nstage;
    }

    // ── 写出：τ_m · s_n · float(acc)（(τ·s)·acc，与宿主参考同序）──────────
#if defined(NN_SHADER_F16)
    for (uint i = 0u; i < 4u; ++i)
    {
        const uint out_row = block_row + ty * 4u + i;
        if (out_row >= M) continue;
        const uint out_col0 = block_col + tx * 4u;
        if (out_col0 >= N) continue;
        Y[out_row * N + out_col0 + 0u] = NN_WR(T[out_row] * S[out_col0 + 0u] * float(acc[i].x));
        if (out_col0 + 1u < N) Y[out_row * N + out_col0 + 1u] = NN_WR(T[out_row] * S[out_col0 + 1u] * float(acc[i].y));
        if (out_col0 + 2u < N) Y[out_row * N + out_col0 + 2u] = NN_WR(T[out_row] * S[out_col0 + 2u] * float(acc[i].z));
        if (out_col0 + 3u < N) Y[out_row * N + out_col0 + 3u] = NN_WR(T[out_row] * S[out_col0 + 3u] * float(acc[i].w));
    }
#else
    if ((N & 3u) == 0u && block_col + BN <= N)
    {
        // 全块列都在界内（N%4==0 ⇒ 行内 4 列恰成 16B 对齐 vec4）
        for (uint i = 0u; i < 4u; ++i)
        {
            const uint out_row = block_row + ty * 4u + i;
            if (out_row >= M) continue;
            const uint c0 = block_col + tx * 4u;
            const vec4 facc = vec4(float(acc[i].x), float(acc[i].y),
                                   float(acc[i].z), float(acc[i].w));
            Yv4[(out_row * N + c0) >> 2u] =
                vec4(T[out_row]) * vec4(S[c0], S[c0 + 1u], S[c0 + 2u], S[c0 + 3u]) * facc;
        }
    }
    else
    {
        for (uint i = 0u; i < 4u; ++i)
        {
            const uint out_row = block_row + ty * 4u + i;
            if (out_row >= M) continue;
            for (uint j = 0u; j < 4u; ++j)
            {
                const uint out_col = block_col + tx * 4u + j;
                if (out_col >= N) continue;
                Y[out_row * N + out_col] = T[out_row] * S[out_col] * float(acc[i][j]);
            }
        }
    }
#endif
}
