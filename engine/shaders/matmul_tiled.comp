// ── matmul_tiled.comp ─────────────────────────────────────────────────────
// vec4 向量化分块矩阵乘法：C[M][N] = A × B（借鉴 llama.cpp/ggml mul_mm 思路）
//
// 支持转置（同 matmul.comp）：
//   - transA=0, transB=0: C[M][N] = A[M][K] × B[K][N]
//   - transA=1, transB=0: C[M][N] = A^T[K,M] × B[K][N]
//   - transA=0, transB=1: C[M][N] = A[M][K] × B^T[N,K]
//   - transA=1, transB=1: C[M][N] = A^T[K,M] × B^T[N,K]
//
// 优化策略：
//   - WorkGroup：16×16 线程，计算 64×64 输出块（每线程 4×4 元素）；
//     细 tile 变体（-DNN_MM_FINE=1）= 4×4 线程 / 16×16 输出块，每线程仍
//     4×4 元素（见文件中段开关注释）
//   - vec4 共享内存：Ash[k][m]（A 转置）/ Bsh[k][n]，每线程每 k 仅 2 次
//     vec4 LDS + 16 FMA（8:1 计算:加载比），vec4 读沿 lane 连续、消除
//     标量读的 bank 冲突
//   - bank swizzle（与融合生成器 P1 同式）：物理槽 = 逻辑槽 ^ ((k>>2) &
//     槽位掩码)，消标量散布写的 4 路 bank 冲突；写读同式 involution
//   - vec4 累加器：acc[4]（4×4 = 16 个累加值），寄存器常驻
//
// 双缓冲流水（BK=16）：Ash/Bsh 各分 2 个 stage，tile t+1 的全局加载与
//   tile t 的计算并行发射；每 tile 仅 1 次 barrier，全局内存延迟
//   （~600 周期）被计算覆盖。共享内存总计 16KB（Ash[2][16][16]vec4 8KB
//   + Bsh 8KB），占用率与单缓冲 BK=32 相同（32KB 变体的实测代价见下方
//   BK 常量注释）。
//
// vec4 全局加载/写出（借鉴 ggml mul_mm 的 ALIGNED/LOAD_VEC 快路径）：
//   - 每线程 EPT 个元素按「转置形态选连续维」分组，对齐时一条 vec4 全局
//     访问替代 4 次标量 + 逐元素边界判断；形状条件为 uniform 分支零开销
//   - 对齐条件（元素下标 %4==0 且组内连续 ⇔）：
//       A: transA=0 需 K%4==0（沿 k 连续）；transA=1 需 M%4==0（沿 m 连续）
//       B: transB=0 需 N%4==0（沿 n 连续）；transB=1 需 K%4==0（沿 k 连续）
//       C: 写出需 N%4==0（沿列连续）
//     基址 16B 对齐由 MemoryPool 分配对齐 ≥16 保证（compute_memory_pool.hpp）
//   - 未对齐（奇数形状）或线程持边界组：回退同组标量 + 边界判零，
//     覆盖分组与 vec4 路径完全一致 → 每个 (k,m) 恰被写一次，语义不变
//   - A/B 全局缓冲以 vec4 别名视图访问（同 binding 双声明，std430）
// ─────────────────────────────────────────────────────────────────────────

#version 450

// [[unroll]] 属性（WIDE R=8 写出路径）需要此扩展
#extension GL_EXT_control_flow_attributes : enable


// ── 精度变体（编译期开关：glslc -DNN_SHADER_F16=1）────────────────────────
// 默认（无宏）= 全 f32（f32 分支宏展开与裸写 f32 代码逐字同形 →
//   SPIR-V 字节零差异）。
// 带宏 = f16 存储变体：缓冲声明 float16_t（GL_EXT_shader_16bit_storage），
//   别名槽改 uvec2（4×half = 8B，std430 步长恰好 8）→ unpackHalf2x16 解出
//   vec4；全局读处统一 float(...) 转 f32、写出处统一 float16_t(...)。
//   **共享 tile / vec4 外积累加 / 分块 / 双缓冲 / barrier 节奏与 f32 同构**，
//   只有全局加载/写出的元素类型变了（§7.2「f32 参考累加 + 输出舍入」）。
//   vec4 快路径的对齐条件不变：f16 下 uvec2 需 8B 对齐 ⇔ 元素下标 %4==0
//   （与 f32 的 vec4 16B 对齐条件同源，故 aligned 判据完全复用）。
#if defined(NN_SHADER_F16)
#extension GL_EXT_shader_16bit_storage : require
#define NN_ETYPE float16_t
#define NN_V4    uvec2
#define NN_LOADV4(arr, i) vec4(unpackHalf2x16(arr[i].x), unpackHalf2x16(arr[i].y))
#define NN_RD(x) float(x)
// f16 写出的 RNE 舍入：float16_t(x) 的 OpFConvert 舍入模式未被规范钉死（实测
// NVIDIA 驱动向零截断 → 权重衰减类写回每步恰掉 1 个 f16 网格步，见
// research/f16_weight_decay/REPORT.md）。packHalf2x16 按 round-half-to-even，
// unpack 回 f32 后值已落在 f16 网格上 → 其后 float16_t() 转换必然精确。
#include "nn_f16_rne.glsl"
#define NN_WR(w) float16_t(nn_f16_rne(w))
#else
#define NN_ETYPE float
#define NN_V4    vec4
#define NN_LOADV4(arr, i) arr[i]
#define NN_RD(x) x
#define NN_WR(x) x
#endif

// ── 网格粒度变体（编译期开关：-DNN_MM_FINE=1 / -DNN_MM_WIDE=1）─────────────
// 默认 = 64×64 输出块（16×16 线程，每线程 4×4 寄存器分块，BK=16）；
// NN_MM_FINE = 16×16 输出块（8×8 线程、每线程 2×2 输出 R=2，BK=16）——
//   动机（P0 wgrad 网格饥饿）：64-tile 网格 < EXPR_MATMUL_FINE_MIN_WGS 时换本变体。
//   ⚠ R 取舍见 expr_spec EXPR_MATMUL_BLOCK_FINE 注释（R=2 甜点，R=4 缩块回退）。
// NN_MM_WIDE = 128×128 输出块（16×16 线程、每线程 8×8 输出 R=8，BK=8）——
//   256 线程、共享 16KB（与 64-tile 同占用率）、每线程 16 个 vec4 累加器。
//   每 k：4 次 LDS.128 + 16 次向量 FFMA → LDS/浮点比是 64-tile 的 1/2。
//   K 累加序仍为 k 升序标量乘加 → 与 64-tile/fine **逐位一致**。
//   后端门槛：128-tile 网格 WG 数 ≥ EXPR_MATMUL_WIDE_MIN_WGS 且 min(M,N)≥128。
//   ⚠ BK=8 ⇒ transB=1 装载分组必须按 KGRP=BK/4 参数化（写死 /4 会越界）。
#if defined(NN_MM_FINE) && defined(NN_MM_WIDE)
#error "NN_MM_WIDE(128x128/8x8) 与 NN_MM_FINE(16x16/2x2) 互斥"
#endif
#if defined(NN_MM_FINE)
#define NN_MM_T    8
#define NN_MM_TU   8u
#define NN_MM_BM   16u
#define NN_MM_BN   16u
#define NN_MM_BK   16u
#define NN_MM_R    2
#elif defined(NN_MM_WIDE)
#define NN_MM_T    16
#define NN_MM_TU   16u
#define NN_MM_BM   128u
#define NN_MM_BN   128u
#define NN_MM_BK   8u
#define NN_MM_R    8
#else
#define NN_MM_T    16
#define NN_MM_TU   16u
#define NN_MM_BM   64u
#define NN_MM_BN   64u
#define NN_MM_BK   16u
#define NN_MM_R    4
#endif

layout(local_size_x = NN_MM_T, local_size_y = NN_MM_T) in;

layout(std430, binding = 0) readonly buffer  BufferA { NN_ETYPE A[]; };
layout(std430, binding = 1) readonly buffer  BufferB { NN_ETYPE B[]; };
layout(std430, binding = 2) writeonly buffer BufferC { NN_ETYPE C[]; };

// vec4 别名视图（同 binding 双声明；仅在元素下标 %4==0 的快路径使用）
layout(std430, binding = 0) readonly buffer  BufferAv4 { NN_V4 Av4[]; };
layout(std430, binding = 1) readonly buffer  BufferBv4 { NN_V4 Bv4[]; };
#if !defined(NN_SHADER_F16)
layout(std430, binding = 2) writeonly buffer BufferCv4 { vec4 Cv4[]; };
#endif

layout(push_constant) uniform PushConstants {
    uint M;      // C 的行数
    uint N;      // C 的列数
    uint K;      // 求和维度
    uint transA; // 与 SC_TRANS_A 同值（PC↔SC 一致性守卫；后端复用同一 PC 布局）
    uint transB; // 与 SC_TRANS_B 同值
};

// ── 特化常量（VkSpecializationInfo，建 pipeline 时烘进 SPIR-V）──────────────
// dispatch 时已知的 uniform 标志：转置方向 + 形状对齐。常量折叠后 fetch/commit
// 热路径无运行时方向分支（死代码整段消除）。默认值 = 0（plain/对齐）——
// **与 PC 不一致时 main 入口直接 return**，防 pipeline cache 串 key 静默错值。
// ⚠ 后端必须为每个 (transA,transB,K%4,M%4,N%4) 组合建特化 pipeline，
//   且 cache key 必须含这 5 个值。f32 SPIR-V 不再与无特化版字节零差异
//   （OpSpecConstant vs OpConstant）；**数值仍逐位一致**。
layout(constant_id = 0) const uint SC_TRANS_A = 0u;
layout(constant_id = 1) const uint SC_TRANS_B = 0u;
layout(constant_id = 2) const uint SC_KMOD4   = 0u;   // K & 3
layout(constant_id = 3) const uint SC_MMOD4   = 0u;   // M & 3
layout(constant_id = 4) const uint SC_NMOD4   = 0u;   // N & 3

const bool K_ALIGNED = (SC_KMOD4 == 0u);
const bool M_ALIGNED = (SC_MMOD4 == 0u);
const bool N_ALIGNED = (SC_NMOD4 == 0u);

// 分块维度常量（见文件头 FINE/WIDE/默认 三档开关注释）
const uint BM = NN_MM_BM;  // 输出块行数
const uint BN = NN_MM_BN;  // 输出块列数
// BK=16 + 双缓冲：Ash[2][16][16]vec4 8KB + Bsh 8KB = 16KB 共享，保占用率
//   （BK=32 双缓冲需 32KB，每 SM 只驻 2 个 WG——四点实测全回退，见 history）；
//   WIDE 档 BK=8：Ash[2][8][32]+Bsh 同样 16KB。
const uint BK = NN_MM_BK; // K 维度分块宽度（16 默认/FINE，8 WIDE）
// transB=1 装载分组：每个 n 上的 4-k 组数。写死 /4 ⇔ BK==16；
// BK=8（WIDE）时必须 =2，否则 half-tile 越界写（复核坑①）。
const uint KGRP = BK / 4u;

// 每线程协作加载元素数（BM*BK/T² 线程）。下方按 4 元素组取 groups=EPT/4：
// 默认 64×16/16² → EPT=4（groups=1）；细 tile 16×16/8² → EPT=4（groups=1，
// g=tid 恰覆盖 tile 的 64 个 vec4，由 g < TILE_V4 守卫兜底）。
const uint EPT_A = (BM * BK) / (NN_MM_TU * NN_MM_TU);  // 64→4 / 16→4
const uint EPT_B = (BK * BN) / (NN_MM_TU * NN_MM_TU);  // 64→4 / 16→4
// 各自 tile 的 vec4 总数（守卫上界；两条路径下 g 都必须落在其内）
const uint TILE_V4_A = (BM * BK) / 4u;                 // 64→256 / 16→64
const uint TILE_V4_B = (BK * BN) / 4u;

// Shared Memory（vec4 布局，16B 对齐，双缓冲 [2][...]）：
//   Ash[stage][k][m]：A^T 分块 —— A[m][k]（转置写共享内存，内层按行连续读）
//   Bsh[stage][k][n]：B 分块 —— B[k][n]（内层按行连续读）
// 每个 vec4 = 4 个 float（64 行/列的 1/4）；stage 交替：tile t 用 t&1
shared vec4 Ash[2][BK][BM / 4];
shared vec4 Bsh[2][BK][BN / 4];

// ── Bank swizzle（P1 旧式；新式 mm_swz 2026-11-15 A/B 否决）──────────────
// 新式 f(a)=(a&3)<<1 理论 2→1 way，但方阵 4096 中性、1024³ 回退 ~24%，
// 实测不采信 → 维持旧式。写读同式 involution → K 累加序不变。
// （mm_swz.glsl 仍被 batched_matmul 使用；本文件不再 include。）
#define SWZ_A(k, slot) ((slot) ^ (((k) >> 2) & (BM / 4u - 1u)))
#define SWZ_B(k, slot) ((slot) ^ (((k) >> 2) & (BN / 4u - 1u)))

// ── 协作加载 A 分块 BM×BK ──────────────────────────────────────────────────
// 线程分组：EPT_A/4 个「4 元素组」，组索引 g = tid*(EPT_A/4) + vv。
// 按 transA 选连续维（全局地址连续 ⇒ vec4 快路径）：
//   transA=0：A[m][k] 行主序，组 = 同行连续 4 个 k（g ↔ m=(4g)/BK, k0=(4g)%BK）
//   transA=1：A 存储 (K,M)，组 = 同 k 连续 4 个 m（g ↔ k=g/(BM/4), mq=g%(BM/4)）
// 未对齐/边界回退走**同一分组**的标量循环 → 覆盖恰好一致。
//
// 【fetch/commit 流水】LDG 只落寄存器（fetch），compute(t) 与 t+1 的 LDG
// 重叠，LDG 回来后再 STS（commit）。原实现 load 内 LDG→STS 相邻，warp 按序
// 发射会停在 STS 等全局数据，compute(t) 被推到 LDG 之后——能否掩盖延迟完全
// 取决于驱动调度器是否把 STS 下沉。累加序 / 共享内容 / barrier 次数不变。
// 暂存代价：每线程 1 个 A vec4 + 1 个 B vec4 = 8 寄存器（EPT=4 ⇒ groups=1）。
const uint MM_GROUPS_A = (EPT_A >= 4u) ? (EPT_A / 4u) : 1u;
const uint MM_GROUPS_B = (EPT_B >= 4u) ? (EPT_B / 4u) : 1u;

// fetch 结果（groups=1 时每线程恰 1 组；多组时循环内复用同一槽——
// 当前 BM/BK/T 组合下 groups 恒为 1）
vec4 mm_sA;
vec4 mm_sB;

void fetch_A_tile(uint t, uint tid, uint block_row)
{
    const uint a_base_col = t * BK;
    const bool k_contig = (SC_TRANS_A == 0u);
    const bool aligned = k_contig ? K_ALIGNED : M_ALIGNED;
    mm_sA = vec4(0.0);
    for (uint vv = 0u; vv < MM_GROUPS_A; ++vv)
    {
        const uint g = tid * MM_GROUPS_A + vv;
        if (g >= TILE_V4_A) continue;
        if (k_contig)
        {
            const uint m  = (4u * g) / BK;
            const uint k0 = (4u * g) % BK;
            const uint gr = block_row + m;
            const uint gc = a_base_col + k0;
            if (aligned && gr < M && gc < K)
                mm_sA = NN_LOADV4(Av4, (gr * K + gc) >> 2);
            else
                for (uint j = 0u; j < 4u; ++j)
                    mm_sA[j] = (gr < M && gc + j < K) ? NN_RD(A[gr * K + gc + j]) : 0.0;
        }
        else
        {
            const uint mq = g % (BM / 4u);
            const uint k  = g / (BM / 4u);
            const uint gc = a_base_col + k;
            const uint gr = block_row + mq * 4u;
            if (aligned && gc < K && gr < M)
                mm_sA = NN_LOADV4(Av4, (gc * M + gr) >> 2);
            else
                for (uint j = 0u; j < 4u; ++j)
                    mm_sA[j] = (gr + j < M && gc < K) ? NN_RD(A[gc * M + gr + j]) : 0.0;
        }
    }
}

void commit_A_tile(uint stage, uint tid, uint block_row)
{
    const bool k_contig = (SC_TRANS_A == 0u);
    for (uint vv = 0u; vv < MM_GROUPS_A; ++vv)
    {
        const uint g = tid * MM_GROUPS_A + vv;
        if (g >= TILE_V4_A) continue;
        if (k_contig)
        {
            const uint m  = (4u * g) / BK;
            const uint k0 = (4u * g) % BK;
            Ash[stage][k0    ][SWZ_A(k0,     m >> 2)][m & 3u] = mm_sA.x;
            Ash[stage][k0 + 1u][SWZ_A(k0 + 1u, m >> 2)][m & 3u] = mm_sA.y;
            Ash[stage][k0 + 2u][SWZ_A(k0 + 2u, m >> 2)][m & 3u] = mm_sA.z;
            Ash[stage][k0 + 3u][SWZ_A(k0 + 3u, m >> 2)][m & 3u] = mm_sA.w;
        }
        else
        {
            const uint mq = g % (BM / 4u);
            const uint k  = g / (BM / 4u);
            Ash[stage][k][SWZ_A(k, mq)] = mm_sA;   // 整槽 STS.128
        }
    }
}

void fetch_B_tile(uint t, uint tid, uint block_col)
{
    const uint b_base_row = t * BK;
    const bool n_contig = (SC_TRANS_B == 0u);
    const bool aligned = n_contig ? N_ALIGNED : K_ALIGNED;
    mm_sB = vec4(0.0);
    for (uint vv = 0u; vv < MM_GROUPS_B; ++vv)
    {
        const uint g = tid * MM_GROUPS_B + vv;
        if (g >= TILE_V4_B) continue;
        if (n_contig)
        {
            const uint k  = (4u * g) / BN;
            const uint n0 = (4u * g) % BN;
            const uint gr = b_base_row + k;
            const uint gc = block_col + n0;
            if (aligned && gr < K && gc < N)
                mm_sB = NN_LOADV4(Bv4, (gr * N + gc) >> 2);
            else
                for (uint j = 0u; j < 4u; ++j)
                    mm_sB[j] = (gr < K && gc + j < N) ? NN_RD(B[gr * N + gc + j]) : 0.0;
        }
        else
        {
            const uint n  = g / KGRP;
            const uint k0 = (g % KGRP) * 4u;
            const uint gc = block_col + n;
            const uint gr = b_base_row + k0;
            if (aligned && gc < N && gr < K)
            {
                const vec4 v = NN_LOADV4(Bv4, (gc * K + gr) >> 2);
                mm_sB = v;
            }
            else
                for (uint j = 0u; j < 4u; ++j)
                    mm_sB[j] = (gr + j < K && gc < N) ? NN_RD(B[gc * K + gr + j]) : 0.0;
        }
    }
}

void commit_B_tile(uint stage, uint tid, uint block_col)
{
    const bool n_contig = (SC_TRANS_B == 0u);
    for (uint vv = 0u; vv < MM_GROUPS_B; ++vv)
    {
        const uint g = tid * MM_GROUPS_B + vv;
        if (g >= TILE_V4_B) continue;
        if (n_contig)
        {
            const uint k  = (4u * g) / BN;
            const uint n0 = (4u * g) % BN;
            // 整槽：n0%4==0 ⇒ 4 元素恰为 slot (n0>>2) 的 .x..w
            Bsh[stage][k][SWZ_B(k, n0 >> 2)] = mm_sB;
        }
        else
        {
            const uint n  = g / KGRP;
            const uint k0 = (g % KGRP) * 4u;
            for (uint j = 0u; j < 4u; ++j)
                Bsh[stage][k0 + j][SWZ_B(k0 + j, n >> 2)][n & 3u] = mm_sB[j];
        }
    }
}

void main()
{
    // PC↔SC 一致性守卫：pipeline cache key 串了（或后端漏传特化值）时
    // 直接退出 → 对拍当场失败，而不是静默算错。
    if (transA != SC_TRANS_A || transB != SC_TRANS_B ||
        (K & 3u) != SC_KMOD4 || (M & 3u) != SC_MMOD4 || (N & 3u) != SC_NMOD4)
        return;

    const uint tx = gl_LocalInvocationID.x;   // 0..T-1
    const uint ty = gl_LocalInvocationID.y;   // 0..T-1
    const uint tid = ty * NN_MM_TU + tx;      // 线性线程 ID 0..T²-1

    // 当前 WorkGroup 负责的全局输出块起始坐标
    const uint block_row = gl_WorkGroupID.y * BM;
    const uint block_col = gl_WorkGroupID.x * BN;

    // ── 寄存器分块 ────────────────────────────────────────────────────
#if NN_MM_R == 2
    // 细 tile：R=2，每线程 2×2 输出（4 条独立 K 链 = 线程内 ILP）
    float a00 = 0.0, a01 = 0.0, a10 = 0.0, a11 = 0.0;
#elif NN_MM_R == 8
    // WIDE：acc[行半][列半][块内行]——行 = rh*64 + ty*4 + i，列 = ch*64 + tx*4 + ·
    vec4 acc[2][2][4];
    for (uint rh = 0u; rh < 2u; ++rh)
        for (uint ch = 0u; ch < 2u; ++ch)
            for (uint i = 0u; i < 4u; ++i)
                acc[rh][ch][i] = vec4(0.0);
#else
    // 4×4 累加器（vec4 数组）
    vec4 acc[4];
    for (uint i = 0u; i < 4u; ++i)
        acc[i] = vec4(0.0);
#endif

    const uint num_tiles = (K + BK - 1u) / BK;

    // ── 前奏：fetch tile 0 → 寄存器 → commit → stage 0，同步一次 ─────────
    fetch_A_tile(0u, tid, block_row);
    fetch_B_tile(0u, tid, block_col);
    commit_A_tile(0u, tid, block_row);
    commit_B_tile(0u, tid, block_col);
    barrier();

    // ── 流水：fetch(t+1) 只发 LDG → compute(t) → commit(t+1) STS ─────────
    //   每 tile 仅 1 次 barrier；barrier 同时保证
    //   ① tile t+1 的 STS 在下一迭代被读取前完成
    //   ② tile t 的计算在 stage^1 被覆盖前完成（与 ①天然错开 stage）
    uint stage = 0u;
    for (uint t = 0u; t < num_tiles; ++t)
    {
        const uint nxt = t + 1u;
        const uint nstage = stage ^ 1u;
        if (nxt < num_tiles)
        {
            fetch_A_tile(nxt, tid, block_row);   // 只发 LDG，落 mm_sA/mm_sB
            fetch_B_tile(nxt, tid, block_col);
        }

        // ── 累加（每 k：2 次 LDS + FMA）——与 t+1 的 LDG 在途重叠 ──────
        // ⚠ 曾试「k+1 预取软件流水」（把 k+1 的 LDS 提到 k 的 FMA 前）：
        // 细 tile 实测 1.33→2.13ms（+60%，寄存器/复制链反而拖累）、64-tile
        // 持平——**该路径不要加预取**（fold 生成器能加是因为其归约域是
        // e[n][128] 私有数组，不是 shared LDS 链）。
        #pragma unroll 4
        for (uint k = 0u; k < BK; ++k)
        {
#if NN_MM_R == 2
            // R=2：行对 ty*2、ty*2+1 → 共享行组 (ty*2)>>2 = ty>>1、组内
            // 基 (ty*2)&3 = (ty&1)*2；列对同构。2 次 vec4 LDS + 4 标量 FMA。
            // 读侧同式 swizzle（involution）→ 与 load 写集合一致。
            const vec4 a_vec = Ash[stage][k][SWZ_A(k, ty >> 1u)];
            const vec4 b_vec = Bsh[stage][k][SWZ_B(k, tx >> 1u)];
            const float ar0 = a_vec[(ty & 1u) * 2u];
            const float ar1 = a_vec[(ty & 1u) * 2u + 1u];
            const float bc0 = b_vec[(tx & 1u) * 2u];
            const float bc1 = b_vec[(tx & 1u) * 2u + 1u];

            a00 += ar0 * bc0;
            a01 += ar0 * bc1;
            a10 += ar1 * bc0;
            a11 += ar1 * bc1;
#elif NN_MM_R == 8
            // WIDE R=8：行半 ty / ty+16、列半 tx / tx+16 → 4 次 vec4 LDS + 64 FMA
            const vec4 a0 = Ash[stage][k][SWZ_A(k, ty)];
            const vec4 a1 = Ash[stage][k][SWZ_A(k, ty + 16u)];
            const vec4 b0 = Bsh[stage][k][SWZ_B(k, tx)];
            const vec4 b1 = Bsh[stage][k][SWZ_B(k, tx + 16u)];
            #define OUTER(dst, av, bv) \
                (dst)[0] += (av).x * (bv); \
                (dst)[1] += (av).y * (bv); \
                (dst)[2] += (av).z * (bv); \
                (dst)[3] += (av).w * (bv)
            OUTER(acc[0][0], a0, b0);
            OUTER(acc[0][1], a0, b1);
            OUTER(acc[1][0], a1, b0);
            OUTER(acc[1][1], a1, b1);
            #undef OUTER
#else
            // 本线程负责的 4 行（ty*4..ty*4+3）与 4 列（tx*4..tx*4+3）
            // vec4 外积累加：2 次 vec4 LDS + 16 FMA = 8:1
            const vec4 a_vec = Ash[stage][k][SWZ_A(k, ty)];
            const vec4 b_vec = Bsh[stage][k][SWZ_B(k, tx)];

            acc[0] += a_vec.x * b_vec;
            acc[1] += a_vec.y * b_vec;
            acc[2] += a_vec.z * b_vec;
            acc[3] += a_vec.w * b_vec;
#endif
        }

        if (nxt < num_tiles)
        {
            commit_A_tile(nstage, tid, block_row);  // LDG 已回，STS 不停顿
            commit_B_tile(nstage, tid, block_col);
        }

        barrier();
        stage = nstage;
    }

    // ── 写入结果 ──────────────────────────────────────────────────────
#if NN_MM_R == 2
    // 细 tile：R=2 逐标量写出（线程 (ty,tx) ↔ 输出块内 2×2；warp 内相邻
    // 列 → 128B 合并写。fine 仅 f32 构建，NN_WR 仍走宏保同形）
    {
        const uint r0 = block_row + ty * 2u;
        const uint c0 = block_col + tx * 2u;
        const float accs[4] = float[4](a00, a01, a10, a11);
        for (uint i = 0u; i < 2u; ++i)
            for (uint j = 0u; j < 2u; ++j)
            {
                const uint out_row = r0 + i;
                const uint out_col = c0 + j;
                if (out_row < M && out_col < N)
                    C[out_row * N + out_col] = NN_WR(accs[i * 2u + j]);
            }
    }
#elif NN_MM_R == 8
    // WIDE R=8 写出：行半 rh / 列半 ch，每线程 8×8 输出
    [[unroll]] for (uint rh = 0u; rh < 2u; ++rh)
        [[unroll]] for (uint i = 0u; i < 4u; ++i)
        {
            const uint out_row = block_row + rh * 64u + ty * 4u + i;
            if (out_row >= M) continue;
            [[unroll]] for (uint ch = 0u; ch < 2u; ++ch)
            {
                const uint out_col0 = block_col + ch * 64u + tx * 4u;
#if defined(NN_SHADER_F16)
                if (out_col0 >= N) continue;
                C[out_row * N + out_col0 + 0u] = NN_WR(acc[rh][ch][i].x);
                if (out_col0 + 1u < N) C[out_row * N + out_col0 + 1u] = NN_WR(acc[rh][ch][i].y);
                if (out_col0 + 2u < N) C[out_row * N + out_col0 + 2u] = NN_WR(acc[rh][ch][i].z);
                if (out_col0 + 3u < N) C[out_row * N + out_col0 + 3u] = NN_WR(acc[rh][ch][i].w);
#else
                const bool c_vec4 = N_ALIGNED;
                if (c_vec4)
                {
                    if (out_col0 < N) Cv4[(out_row * N + out_col0) >> 2u] = acc[rh][ch][i];
                }
                else
                {
                    if (out_col0 >= N) continue;
                    C[out_row * N + out_col0 + 0u] = acc[rh][ch][i].x;
                    if (out_col0 + 1u < N) C[out_row * N + out_col0 + 1u] = acc[rh][ch][i].y;
                    if (out_col0 + 2u < N) C[out_row * N + out_col0 + 2u] = acc[rh][ch][i].z;
                    if (out_col0 + 3u < N) C[out_row * N + out_col0 + 3u] = acc[rh][ch][i].w;
                }
#endif
            }
        }
#elif defined(NN_SHADER_F16)
    // f16 输出：逐标量写出（C 无 vec4 别名视图），与 f32 的 N%4!=0 分支同构
    for (uint i = 0u; i < 4u; ++i)
    {
        const uint out_row = block_row + ty * 4u + i;
        if (out_row >= M) continue;
        const uint out_col0 = block_col + tx * 4u;
        if (out_col0 >= N) continue;
        C[out_row * N + out_col0 + 0u] = NN_WR(acc[i].x);
        if (out_col0 + 1u < N)
            C[out_row * N + out_col0 + 1u] = NN_WR(acc[i].y);
        if (out_col0 + 2u < N)
            C[out_row * N + out_col0 + 2u] = NN_WR(acc[i].z);
        if (out_col0 + 3u < N)
            C[out_row * N + out_col0 + 3u] = NN_WR(acc[i].w);
    }
#else
    // vec4 快路径（N%4==0，uniform）：out_col0%4==0 且 out_col0<N
    //   ⇒ out_col0+3<N（整组在行内），单条 vec4 写出免 3 次边界判断。
    // 否则逐标量 + 边界判断（列尾残余 / 奇数形状）。
    const bool c_vec4 = ((N & 3u) == 0u);
    for (uint i = 0u; i < 4u; ++i)
    {
        const uint out_row = block_row + ty * 4u + i;
        if (out_row >= M) continue;
        const uint out_col0 = block_col + tx * 4u;
        if (c_vec4)
        {
            if (out_col0 < N)
                Cv4[(out_row * N + out_col0) >> 2] = acc[i];
        }
        else
        {
            if (out_col0 >= N) continue;
            C[out_row * N + out_col0 + 0u] = acc[i].x;
            if (out_col0 + 1u < N)
                C[out_row * N + out_col0 + 1u] = acc[i].y;
            if (out_col0 + 2u < N)
                C[out_row * N + out_col0 + 2u] = acc[i].z;
            if (out_col0 + 3u < N)
                C[out_row * N + out_col0 + 3u] = acc[i].w;
        }
    }
#endif
}
